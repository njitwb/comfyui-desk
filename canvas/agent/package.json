{
  "name": "@zhuyichuan/canvas-agent",
  "version": "0.7.0",
  "packageManager": "npm@11.12.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "canvas-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "agent-instructions.md",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "debug": "tsx src/index.ts --debug",
    "test": "tsx --test src/config.test.ts src/canvas/operations.test.ts src/canvas/session.test.ts src/agent/harness-mapping.test.ts src/agent/message-metadata.test.ts src/utils/agent-runtime.test.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "strip-ansi": "7.2.0",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
